# Default: fully local inference through Ollama.
ARCLEDGER_LLM_PROVIDER=ollama
ARCLEDGER_LLM_MODEL=gemma3:4b
ARCLEDGER_EMBEDDING_PROVIDER=ollama
ARCLEDGER_EMBEDDING_MODEL=embeddinggemma
ARCLEDGER_INFERENCE_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_REQUEST_TIMEOUT=120s

# Deterministic, model-free mode for tests and basic demos:
# ARCLEDGER_LLM_PROVIDER=rule-based
# ARCLEDGER_EMBEDDING_PROVIDER=hash
# ARCLEDGER_INFERENCE_ENABLED=false

# To use the optional OpenAI Responses adapter:
# ARCLEDGER_LLM_PROVIDER=openai
# OPENAI_API_KEY=replace-me
# ARCLEDGER_LLM_MODEL=gpt-4.1-mini
# ARCLEDGER_LLM_ENDPOINT=https://api.openai.com/v1/responses
ARCLEDGER_DB_URL=jdbc:postgresql://localhost:5432/arcledger
ARCLEDGER_DB_USER=arcledger
ARCLEDGER_DB_PASSWORD=replace-with-a-long-random-local-password
ARCLEDGER_VECTOR_STORE_PROVIDER=pgvector
ARCLEDGER_EMBEDDING_DIMENSIONS=768

# Browser authentication. Keep secure cookies enabled behind HTTPS.
ARCLEDGER_COOKIE_SECURE=false
ARCLEDGER_ALLOWED_ORIGINS=http://localhost:5173
ARCLEDGER_SESSION_TIMEOUT=12h
ARCLEDGER_BCRYPT_STRENGTH=12
ARCLEDGER_MAX_REQUEST_BODY_BYTES=131072
ARCLEDGER_SIGNUP_RATE_LIMIT=5
ARCLEDGER_SIGNUP_RATE_WINDOW_SECONDS=3600
ARCLEDGER_LOGIN_RATE_LIMIT=10
ARCLEDGER_LOGIN_RATE_WINDOW_SECONDS=60
ARCLEDGER_SCENE_RATE_LIMIT=10
ARCLEDGER_SCENE_RATE_WINDOW_SECONDS=300
ARCLEDGER_QUESTION_RATE_LIMIT=30
ARCLEDGER_QUESTION_RATE_WINDOW_SECONDS=60
ARCLEDGER_BACKGROUND_PROCESSING=true
ARCLEDGER_JOB_BATCH_SIZE=1
ARCLEDGER_JOB_MAX_ATTEMPTS=3
ARCLEDGER_JOB_RETRY_BASE_SECONDS=15
ARCLEDGER_JOB_RETRY_MAX_SECONDS=300
ARCLEDGER_JOB_LEASE_SECONDS=420
ARCLEDGER_JOB_RETENTION_DAYS=30
ARCLEDGER_DISTRIBUTED_RATE_LIMITS=true

# Account lifecycle and privacy. Generate the audit key independently; never commit real values.
ARCLEDGER_AUDIT_HASH_KEY=replace-with-at-least-32-random-characters
ARCLEDGER_ADMIN_EMAILS=
ARCLEDGER_REQUIRE_EMAIL_VERIFICATION=false
ARCLEDGER_RECOVERY_RATE_LIMIT=5
ARCLEDGER_RECOVERY_RATE_WINDOW_SECONDS=3600
ARCLEDGER_INVITATION_RATE_LIMIT=20
ARCLEDGER_INVITATION_RATE_WINDOW_SECONDS=3600

# Outbound account email. Enable verification only after SMTP delivery has been tested.
ARCLEDGER_MAIL_ENABLED=false
ARCLEDGER_MAIL_FROM=noreply@arc.srishtis.dev
ARCLEDGER_PUBLIC_URL=https://arc.srishtis.dev
ARCLEDGER_SMTP_HOST=smtp.example.com
ARCLEDGER_SMTP_PORT=587
ARCLEDGER_SMTP_USERNAME=
ARCLEDGER_SMTP_PASSWORD=
ARCLEDGER_SMTP_AUTH=true
ARCLEDGER_SMTP_STARTTLS=true
