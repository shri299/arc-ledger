FROM postgres:16-alpine

RUN apk add --no-cache openssl

COPY backup.sh restore-verify.sh migration-check.sh backup-loop.sh /usr/local/bin/
RUN chmod 0555 /usr/local/bin/backup.sh /usr/local/bin/restore-verify.sh \
    /usr/local/bin/migration-check.sh /usr/local/bin/backup-loop.sh

USER 1001:1001
ENTRYPOINT ["/usr/local/bin/backup-loop.sh"]
